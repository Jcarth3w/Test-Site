# For local dev when running `npm run dev` in backend/ (not Docker backend).
# Postgres should be running via `npm run dev:db` from the repo root.

DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/test_site
PGSSL=false
PORT=5001

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
