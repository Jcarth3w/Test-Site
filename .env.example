# Copy to .env and fill in values before running: docker compose up -d --build

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=test_site

# Backend auth (used for CMS login and first-run admin bootstrap)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me

# Public site URL (optional; used for CORS allowlist)
# PUBLIC_BASE_URL=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com

# Host port nginx listens on (default 80)
HTTP_PORT=80
